      "node_type": "chunk",
      "text": "while (i < n1 && j < n2) {\n if (arr1[i] < arr2[j]) {\n merged[k++] = arr1[i++];\n } else {\n merged[k++] = arr2[j++];\n }\n }\n\nwhile (i < n1) {\n merged[k++] = arr1[i++];\n }\n\nwhile (j < n2) {\n merged[k++] = arr2[j++];\n }\n}\n\nint main() {\n int n1, n2;\n\n// Input the size of the collections for Aneesh and Surya\n printf(\"Enter the number of integers for Aneesh: \");\n scanf(\"%d\", &n1);\n printf(\"Enter the number of integers for Surya: \");\n scanf(\"%d\", &n2);\n\nint aneesh[n1], surya[n2];\n\n// Input the integers for Aneesh's collection\n printf(\"Enter the integers for Aneesh:\\n\");\n for (int i = 0; i < n1; i++) {\n scanf(\"%d\", &aneesh[i]);\n }\n\n// Input the integers for Surya's collection\n printf(\"Enter the integers for Surya:\\n\");\n for (int i = 0; i < n2; i++) {\n scanf(\"%d\", &surya[i]);\n }",
