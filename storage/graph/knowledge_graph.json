      "text": "rya's collection\n printf(\"Enter the integers for Surya:\\n\");\n for (int i = 0; i < n2; i++) {\n scanf(\"%d\", &surya[i]);\n }\n\n// Sort Aneesh's collection using Quick Sort\n quickSort(aneesh, 0, n1 - 1);\n\n// Sort Surya's collection using Quick Sort\n quickSort(surya, 0, n2 - 1);\n\n// Calculate the size of the merged array\n int mergedSize = n1 + n2;\n int merged[mergedSize];\n\n// Merge the sorted collections\n mergeSortedArrays(aneesh, n1, surya, n2, merged);\n\n// Print the combined sorted collection\n printf(\"Combined Sorted Integer Collection:\\n\");\n for (int i = 0; i < mergedSize; i++) {\n printf(\"%d \", merged[i]);\n }\n\nreturn 0;\n}",
